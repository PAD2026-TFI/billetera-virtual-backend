{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=WalletDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Identity": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "Wallet.Api",
    "Audience": "Wallet.Client",
    "LifetimeMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "*"
    ]
  },
  "FrontendUrl": "https://padi-billetera.netlify.app",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Documentation": {
    "Enabled": false
  }
}
