        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MerchantPaymentDto"
                  }
                },
                "example": [
                  {
                    "id": "22222222-2222-4222-8222-222222222222",
                    "paymentLinkId": "11111111-1111-4111-8111-111111111111",
                    "destinationWalletId": "33333333-3333-4333-8333-333333333333",
                    "amount": 1500,
                    "currency": "ARS",
                    "paymentMethod": "Wallet",
                    "status": "Succeeded",
                    "transferId": "44444444-4444-4444-8444-444444444444",
                    "cardBrand": null,
                    "cardLast4": null,
                    "cardHolderName": null,
                    "authorizationCode": "WALLET-PAY",
                    "failureReason": null,
                    "createdAt": "2026-11-09T18:05:00+00:00",
                    "completedAt": "2026-11-09T18:05:00+00:00"
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ],
        "description": "Los ejemplos de identificadores, fechas y respuestas son ficticios y muestran el contrato. Reemplazalos por los valores recibidos en tu integración. Devuelve los cobros del comercio, del más reciente al más antiguo. limit vale 20 por defecto y se ajusta internamente al rango 1 a 100. No hay cursor ni paginación.",
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl --fail-with-body \"https://padi.runasp.net/api/v1/integrations/received-payments?limit=20\" \\\n  -H \"X-Api-Key: $PADI_API_KEY\""
          },
          {
            "lang": "powershell",
            "label": "PowerShell",
