{
  "Identity": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "Wallet.Api",
    "Audience": "Wallet.Client",
    "LifetimeMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Payments": {
    "Enabled": false,
    "MaxTopUpAmount": 100000,
    "TimeoutSeconds": 15
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}
