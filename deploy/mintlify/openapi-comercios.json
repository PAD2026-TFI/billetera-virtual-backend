    "/api/v1/integrations/webhook": {
      "put": {
        "tags": [
          "Webhooks y notificaciones"
        ],
        "summary": "Configurar URL de webhook para eventos en tiempo real",
        "operationId": "Gateway_ConfigureWebhook",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "webhookUrl",
                  "webhookSecret"
                ],
                "properties": {
                  "webhookUrl": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048,
                    "description": "URL HTTPS pública donde Padi enviará los eventos POST"
                  },
                  "webhookSecret": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 256,
                    "description": "Secreto compartido para firmar la notificación con HMAC-SHA256"
                  }
                }
              },
              "example": {
                "webhookUrl": "https://mitienda.com/api/padi/webhook",
                "webhookSecret": "secreto_compartido_de_al_menos_32_caracteres_123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook configurado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "companyName": {
                      "type": "string"
                    },
                    "cuit": {
                      "type": "string"
                    },
                    "contactEmail": {
                      "type": "string"
                    },
                    "webhookUrl": {
                      "type": "string",
                      "nullable": true
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos de webhook inválidos"
          },
          "401": {
            "description": "No autorizado / API Key inválida"
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Webhooks y notificaciones"
        ],
        "summary": "Desactivar suscripción a webhooks",
        "operationId": "Gateway_DeactivateWebhook",
        "responses": {
          "200": {
            "description": "Webhook desactivado exitosamente"
          },
          "401": {
            "description": "No autorizado"
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/api/v1/integrations/transfers": {
      "post": {
        "tags": [
          "Transferencias y retiros B2B"
        ],
        "summary": "Transferir saldo B2B por alias, CVU o ID de billetera",
        "operationId": "Gateway_ProcessPayment",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Guardá un UUID por transferencia y reutilizalo con el mismo importe y destino en los reintentos. Si se omite, Padi genera una clave nueva por llamada."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "amount"
                ],
                "properties": {
                  "destinationWalletId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Identificador único de la billetera destino"
                  },
                  "amount": {
                    "type": "number",
                    "format": "double",
                    "description": "Importe en ARS a transferir",
                    "minimum": 0.01,
                    "maximum": 780400,
                    "multipleOf": 0.01
                  },
                  "alias": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 40,
                    "description": "Alias de Padi. Admite letras, números, puntos y guiones."
                  },
                  "cvu": {
                    "type": "string",
                    "pattern": "^[0-9]{22}$",
                    "description": "CVU de Padi. Enviá los 22 dígitos como texto."
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "destinationWalletId"
                    ]
                  },
                  {
                    "required": [
                      "alias"
                    ]
                  },
                  {
                    "required": [
                      "cvu"
                    ]
                  }
                ]
              },
              "examples": {
                "alias": {
                  "summary": "Por alias",
                  "value": {
                    "alias": "jugador.padi",
                    "amount": 2000
                  }
                },
                "cvu": {
                  "summary": "Por CVU",
                  "value": {
                    "cvu": "0000123400000000000123",
                    "amount": 2000
                  }
                },
                "walletId": {
                  "summary": "Por ID de billetera",
                  "value": {
                    "destinationWalletId": "c7a40b93-5491-4cf1-bf50-136faad91b94",
                    "amount": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Repetición idempotente de una transferencia previa",
            "headers": {
              "Idempotency-Replayed": {
                "description": "Indica si se devolvió una transferencia anterior.",
                "schema": {
                  "type": "boolean"
                },
                "example": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/B2BTransferResponse"
                }
              }
            }
          },
          "201": {
            "description": "Transferencia realizada con éxito",
            "headers": {
              "Idempotency-Replayed": {
                "description": "Indica si se devolvió una transferencia anterior.",
                "schema": {
                  "type": "boolean"
                },
                "example": false
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/B2BTransferResponse"
                }
              }
            }
          },
          "400": {
            "description": "Importe, clave o destino inválido, o billeteras idénticas"
          },
          "401": {
            "description": "API Key ausente o inválida"
          },
          "403": {
            "description": "La API Key no corresponde a un cliente externo"
          },
          "404": {
            "description": "Billetera de origen inexistente"
          },
          "409": {
            "description": "Saldo insuficiente, límite de destino o conflicto de concurrencia o idempotencia"
          },
          "422": {
            "description": "Billetera destino no disponible o inexistente"
          },
          "503": {
            "description": "Almacenamiento temporalmente no disponible"
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ],
        "description": "Requiere una API Key de ExternalClient. Padi debita la billetera de esa integración y acredita la billetera destino."
      }
    },
    "/api/v1/integrations/set-password": {
      "post": {
        "tags": [
          "Acceso de Comercios B2B a la App"
        ],
        "summary": "Configurar credenciales para acceder a la aplicación web/móvil",
        "operationId": "Gateway_SetPassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "password"
                ],
                "properties": {
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128,
                    "description": "Contraseña para iniciar sesión en la app"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "nullable": true,
                    "description": "Correo de acceso (opcional, usa contactEmail por defecto)"
                  },
                  "firstName": {
                    "type": "string",
                    "nullable": true,
                    "description": "Nombre de la persona o razón social"
                  },
                  "lastName": {
                    "type": "string",
                    "nullable": true,
                    "description": "Apellido de contacto"
                  }
                }
              },
              "example": {
                "password": "PasswordSuperSeguro123!",
                "email": "admin@casinoroyale.com",
                "firstName": "Casino",
                "lastName": "Royale"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credenciales creadas correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "email": {
                      "type": "string"
                    },
                    "firstName": {
                      "type": "string"
                    },
                    "lastName": {
                      "type": "string"
                    },
                    "accountType": {
                      "type": "string"
                    },
                    "walletId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Contraseña menor a 8 caracteres o entrada inválida"
          },
          "401": {
            "description": "No autorizado / API Key inválida"
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "API Key generada en Integraciones de la app. Guardala y usala desde el servidor de tu comercio."
      }
    },
    "schemas": {
      "PaymentIntentResponse": {
        "required": [
          "id",
          "token",
          "amount",
          "currency",
          "title",
          "description",
          "status",
          "type",
          "createdAt",
          "expiresAt",
          "checkoutUrl",
          "qrCodeUrl"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador del enlace. Guardalo junto al pedido; no es el id del pago."
          },
          "token": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "Estado del enlace: Active, Completed, Expired o Cancelled. Un enlace MultiUse puede seguir Active después de recibir pagos. La consulta por id no garantiza refrescar un vencimiento por tiempo: revisá expiresAt."
          },
          "type": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "checkoutUrl": {
            "type": "string",
            "description": "URL del checkout devuelta por Padi. Usala tal como se recibe."
          },
          "qrCodeUrl": {
            "type": "string",
            "description": "URL de la imagen SVG del QR del checkout."
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "code": {
            "type": "string",
            "description": "Código de error, cuando el endpoint lo incluye. Ejemplos: INVALID_INPUT, PAYMENT_INTENT_NOT_FOUND, PAYMENT_NOT_FOUND."
          },
          "traceId": {
            "type": "string",
            "description": "Identificador de seguimiento, cuando está disponible."
          }
        }
      },
      "CreatePaymentIntentRequest": {
        "required": [
          "amount",
          "title"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Importe en pesos argentinos, mayor que cero y con hasta dos decimales. 1500 representa $1.500.",
            "minimum": 0,
            "exclusiveMinimum": true,
            "multipleOf": 0.01
          },
          "title": {
            "type": "string",
            "description": "Concepto del pedido, obligatorio y no vacío. No superar 128 caracteres para respetar el almacenamiento del enlace."
          },
          "currency": {
            "type": "string",
            "default": "ARS",
            "nullable": true,
            "description": "Usá ARS. Los cobros actuales se generan en pesos argentinos; enviar otro código no habilita otra moneda."
          },
          "description": {
            "type": "string",
            "default": null,
            "nullable": true,
            "description": "Detalle opcional del pedido. No superar 512 caracteres."
          },
          "type": {
            "$ref": "#/components/schemas/PaymentLinkType2",
            "description": "SingleUse para un solo pago exitoso; MultiUse para recibir varios pagos del mismo importe."
          },
          "ttlMinutes": {
            "type": "integer",
            "format": "int32",
            "default": null,
            "nullable": true,
            "description": "Minutos de vigencia. Un valor positivo establece expiresAt. Si se omite, es nulo o no es positivo, no se establece vencimiento por TTL."
          }
        }
      },
      "MerchantPaymentDto": {
        "required": [
          "id",
          "paymentLinkId",
          "destinationWalletId",
          "amount",
          "currency",
          "paymentMethod",
          "status",
          "transferId",
          "cardBrand",
          "cardLast4",
          "cardHolderName",
          "authorizationCode",
          "failureReason",
          "createdAt",
          "completedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador del pago recibido, distinto del identificador del enlace."
          },
          "paymentLinkId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador del enlace que originó este pago."
          },
          "destinationWalletId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Pending, Processing, Succeeded, Failed o Cancelled. Solo Succeeded confirma un pago exitoso."
          },
          "transferId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "cardBrand": {
            "type": "string",
            "nullable": true
          },
          "cardLast4": {
            "type": "string",
            "nullable": true
          },
          "cardHolderName": {
            "type": "string",
            "nullable": true
          },
          "authorizationCode": {
            "type": "string",
            "nullable": true
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "PaymentLinkType2": {
        "enum": [
          "SingleUse",
          "MultiUse"
        ],
        "default": "SingleUse"
      },
      "B2BTransferResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sourceWalletId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationWalletId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
