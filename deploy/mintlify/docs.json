{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "padi.",
  "colors": {
    "primary": "#5B2EE0",
    "light": "#B9A6FF",
    "dark": "#2A0E7A"
  },
  "navigation": {
    "groups": [
      {
        "group": "Primeros pasos",
        "pages": [
          "index",
          "crear-cuenta-vendedor"
        ]
      },
      {
        "group": "Cobrar con Padi",
        "pages": [
          "cobrar-desde-app",
          "confirmar-cobro"
        ]
      },
      {
        "group": "Conectar tu sistema",
        "pages": [
          "integraciones"
        ]
      },
      {
        "group": "Integración por API",
        "pages": [
          "api/primer-cobro",
          "api/errores-y-reintentos",
          {
            "group": "Endpoints de cobro",
            "pages": [
              "api/endpoints/crear-cobro",
              "api/endpoints/consultar-enlace",
              "api/endpoints/listar-pagos",
              "api/endpoints/consultar-pago"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/autenticacion",
      "destination": "/crear-cuenta-vendedor"
    },
    {
      "source": "/cobros",
      "destination": "/cobrar-desde-app"
    },
    {
      "source": "/confirmacion-de-pagos",
      "destination": "/confirmar-cobro"
    }
  ],
  "logo": {
    "light": "/logo/padi-light.svg",
    "dark": "/logo/padi-dark.svg",
    "href": "/"
  },
  "fonts": {
    "family": "Geist"
  },
  "search": {
    "prompt": "Buscar en las guías de Padi"
  },
  "navbar": {
    "links": [
      {
        "label": "Guías para comercios",
        "href": "/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Abrir Padi",
      "href": "https://padi-billetera.netlify.app/"
    }
  },
  "api": {
    "playground": {
      "display": "none"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript"
      ],
      "defaults": "required"
    }
  }
}
