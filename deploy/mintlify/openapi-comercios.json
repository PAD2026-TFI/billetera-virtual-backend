{
  "openapi": "3.0.4",
  "info": {
    "title": "Padi: cobros para sistemas externos",
    "version": "v1",
    "description": "Creá enlaces y consultá los cobros de tu cuenta de vendedor con la API Key obtenida desde la app."
  },
  "servers": [
    {
      "url": "https://padi.runasp.net",
      "description": "Backend alojado de Padi, entorno académico"
    }
  ],
  "paths": {
    "/api/v1/integrations/payment-links": {
      "post": {
        "tags": [
          "Cobros del comercio"
        ],
        "summary": "Crear link de cobro para el comercio autenticado",
        "operationId": "PaymentIntents_Create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentIntentRequest"
              },
              "example": {
                "amount": 1500,
                "title": "Pedido 1042",
                "currency": "ARS",
                "description": "Remera talle L",
                "type": "SingleUse",
                "ttlMinutes": 30
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentIntentResponse"
                },
                "example": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "token": "0123456789abcdef0123456789abcdef",
                  "amount": 1500,
                  "currency": "ARS",
                  "title": "Pedido 1042",
                  "description": "Remera talle L",
                  "status": "Active",
                  "type": "SingleUse",
                  "createdAt": "2026-11-09T18:00:00+00:00",
                  "expiresAt": "2026-11-09T18:30:00+00:00",
                  "checkoutUrl": "https://padi-billetera.netlify.app/checkout?token=0123456789abcdef0123456789abcdef",
                  "qrCodeUrl": "https://padi.runasp.net/api/v1/public/payment-links/0123456789abcdef0123456789abcdef/qr"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ],
        "description": "Los ejemplos de identificadores, fechas y respuestas son ficticios y muestran el contrato. Reemplazalos por los valores recibidos en tu integración. Cada solicitud puede generar otro enlace: no tiene deduplicación por Idempotency-Key.",
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl --fail-with-body \"https://padi.runasp.net/api/v1/integrations/payment-links\" \\\n  -H \"X-Api-Key: $PADI_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  --data '{\"amount\":1500,\"title\":\"Pedido 1042\",\"currency\":\"ARS\",\"type\":\"SingleUse\",\"ttlMinutes\":30}'"
          },
          {
            "lang": "powershell",
            "label": "PowerShell",
            "source": "$headers = @{ \"X-Api-Key\" = $env:PADI_API_KEY }\n$body = @{ amount = 1500; title = \"Pedido 1042\"; currency = \"ARS\"; type = \"SingleUse\"; ttlMinutes = 30 } | ConvertTo-Json\nInvoke-RestMethod -Method Post -Uri \"https://padi.runasp.net/api/v1/integrations/payment-links\" -Headers $headers -ContentType \"application/json\" -Body $body"
          }
        ]
      }
    },
